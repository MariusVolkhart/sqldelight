CREATE TABLE person (
  _id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  first_name TEXT NOT NULL,
  last_name TEXT NOT NULL
);

insertAndReturn1:
INSERT INTO person
VALUES (?, ?, ?)
RETURNING name;

insertAndReturnMany:
INSERT INTO person
VALUES (?, ?, ?)
RETURNING _id, first_name;

insertAndReturnAll:
INSERT INTO person
VALUES (?, ?, ?)
RETURNING *;
